use strict;
use warnings;
use Test::More tests => 19;
use File::Temp qw(tempdir);
use File::Spec;
require './BlissMixerLab/MaterialLoader.pm';
my $dir = tempdir(CLEANUP => 1);
my $path = File::Spec->catfile($dir, 'custom.js');
sub content { open my $f, '<', $path or die $!; local $/; return <$f> }
open my $out, '>', $path or die $!; print {$out} "existing user script\n"; close $out;
ok(Plugins::BlissMixerLab::MaterialLoader::install($path), 'install into existing file');
like(content(), qr/^existing user script\n/, 'existing contents preserved');
like(content(), qr/BLISSMIXERLAB MATERIAL LOADER BEGIN/, 'managed marker added');
my @backups = glob(File::Spec->catfile($dir, '.blissmixerlab-custom-backup-*'));
is(scalar @backups, 1, 'original customization has one backup');
open my $backup, '<', $backups[0] or die $!; local $/; my $saved = <$backup>; close $backup;
is($saved, "existing user script\n", 'backup preserves original bytes');
my $once = content();
ok(Plugins::BlissMixerLab::MaterialLoader::install($path), 'reinstall succeeds');
is(content(), $once, 'reinstall is idempotent');
open $out, '>', $path or die $!; print {$out} "/* Experimental Material customization; not part of Material or Bliss Mixer Lab. */\n"; close $out;
my $prototype = content();
eval { Plugins::BlissMixerLab::MaterialLoader::install($path) };
like($@, qr/prototype/i, 'standalone prototype is reported');
is(content(), $prototype, 'standalone prototype is preserved');
open $out, '>', $path or die $!; print {$out} "// BLISSMIXERLAB MATERIAL LOADER BEGIN\n"; close $out;
eval { Plugins::BlissMixerLab::MaterialLoader::install($path) };
like($@, qr/marker/i, 'unbalanced marker is rejected');
is(content(), "// BLISSMIXERLAB MATERIAL LOADER BEGIN\n", 'malformed file is preserved');
open my $fixture, '<', 'tests/fixtures/material-library-prototype.js' or die $!;
binmode $fixture; my $known_prototype = <$fixture>; close $fixture;
open $out, '>', $path or die $!; binmode $out; print {$out} $known_prototype; close $out;
ok(Plugins::BlissMixerLab::MaterialLoader::install($path), 'known standalone prototype is migrated');
unlike(content(), qr/Experimental Material customization/, 'standalone prototype is not left active');
like(content(), qr/BLISSMIXERLAB MATERIAL LOADER BEGIN/, 'replacement contains managed loader');
@backups = glob(File::Spec->catfile($dir, '.blissmixerlab-custom-backup-*'));
my $found_backup = 0;
for my $file (@backups) { open my $b, '<', $file or die $!; binmode $b; my $bytes = <$b>; close $b; $found_backup = 1 if $bytes eq $known_prototype }
ok($found_backup, 'exact standalone prototype is backed up');
my $valid = content();
open $out, '>>', $path or die $!; print {$out} "// BLISSMIXERLAB MATERIAL LOADER BEGIN\n"; close $out;
my $duplicate = content();
eval { Plugins::BlissMixerLab::MaterialLoader::install($path) };
like($@, qr/marker/i, 'extra managed marker is rejected');
is(content(), $duplicate, 'extra-marker file is preserved');
open $out, '>', $path or die $!; print {$out} "doSomething()"; close $out;
ok(Plugins::BlissMixerLab::MaterialLoader::install($path), 'loader can follow unterminated user statement');
like(content(), qr/^doSomething\(\)\n;\n\/\/ BLISSMIXERLAB/, 'loader is separated by an explicit semicolon');
